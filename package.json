    "test:pg": "DATABASE_URL=postgres://postgres@localhost:5433/finance_training?host=/tmp ADAPTER=pg node --test test/"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.13.0"
  }
}
